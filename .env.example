# Von @BotFather erhaltener Bot-Token
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Deine Chat-ID (siehe README, Abschnitt "Chat-ID herausfinden")
TELEGRAM_CHAT_ID=123456789

# Pfad zur SQLite-Datenbank (innerhalb des Containers, per Volume auf dem Pi persistiert)
DB_PATH=/app/data/dd-was-geht.db

# Um wieviel Uhr der tägliche Push geschickt wird (24h-Format, Europe/Berlin)
DAILY_SEND_HOUR=8
DAILY_SEND_MINUTE=0

# Wochentag (0=Montag ... 6=Sonntag) und Uhrzeit für die Wochenübersicht
WEEKLY_SEND_DAY=0
WEEKLY_SEND_HOUR=8
WEEKLY_SEND_MINUTE=15

# Wie viele Top-Empfehlungen der tägliche Push maximal enthält
DAILY_TOP_N=6

# Cover-Bild im Telegram-Digest, wo die Quelle eins mitgeliefert hat
# (Events ohne Bild bleiben ganz normale Textzeilen). false = wie früher, nur Text.
NEWSLETTER_COVERS=true

# Kategorien, die standardmäßig aus Newsletter (Telegram) und Web-Startansicht
# gefiltert werden - im Web-UI aber weiterhin über den Kategorie-Chip
# erreichbar. Kommagetrennt, z.B. "familie,outdoor". Leer lassen = nichts filtern.
EXCLUDED_CATEGORIES=familie,fuehrungen

# Port für die Web-Oberfläche im Container
WEB_PORT=8080

# Ab diesem "Für dich"-Score (0-100, 50 = neutral) wird ein Event in der
# Web-Liste als Treffer hervorgehoben. Zielwert ist 80; solange wenig
# Bewertungen vorliegen, kommt kaum ein Event dort hin - die Glättung im
# Scoring deckelt die Werte. 70 ist am Anfang der realistische Wert.
HIGHLIGHT_SCORE=70

# --- Resident Advisor (ra.co) als Quelle ------------------------------------
# Clubkultur/Electronic, über die offene GraphQL-Schnittstelle von ra.co.
# Braucht keinen Schlüssel und kostet nichts, deshalb standardmäßig an.
RA_ENABLED=true

# Gebiets-ID auf ra.co. 150 = Dresden. Andere IDs (Auszug): 149 Leipzig,
# 265 Chemnitz, 356 Sachsen, 34 Berlin. Die vollständige Liste liefert die
# GET_AREAS-Abfrage, siehe README.
RA_AREA_ID=150

# --- CyberSAX / SAX-Terminal (cybersax.de) als Quelle ------------------------
# Der Tageskalender des SAX-Stadtmagazins und die einzige Quelle, die die
# kleinen Läden mit Programm systematisch listet (Blue Note, Café Saite,
# Kafé Zeitlos, Der Lude, Kleinkunstbühne Q24 ...). Braucht keinen Schlüssel.
# Übernommen wird bewusst nur ein Teil: die großen Häuser (Semperoper,
# Frauenkirche, Residenzschloss ...) stehen schon im Kulturkalender und werden
# beim Scrapen aussortiert - siehe cybersax.BIG_VENUE_SLUGS und README.
CYBERSAX_ENABLED=true

# --- AZ Conni (azconni.de) als Quelle ----------------------------------------
# Einzelnes Haus, das in keinem Aggregator auftaucht und deshalb direkt geholt
# wird. Eine Anfrage pro Lauf (eine Übersichtsseite für alle Termine).
AZCONNI_ENABLED=true

# --- Sektor Evolution (sektor-evolution.de) als Quelle -----------------------
# Das Haus steht zwar in den Aggregatoren, der Link zeigte dann aber auf ra.co
# statt auf den Laden. Mit dieser Quelle ganz vorn in SOURCE_PRIORITY verlinkt
# der Newsletter den Termin auf sektor-evolution.de. Eine Anfrage für die
# Übersicht plus eine je Termin im Zeitraum (nur die Detailseite nennt die
# Uhrzeit).
SEKTOR_ENABLED=true

# --- Doppelungen zwischen den Quellen ---------------------------------------
# Dieselbe Clubnacht steht oft auf rauze.de UND auf ra.co. Erkannte Doppelungen
# werden verbucht und nur einmal ausgeliefert; sichtbar bleibt die Version der
# Quelle, die hier weiter vorn steht. Nachsehen, was ausgeblendet wurde:
#   docker compose exec dd-was-geht python3 tools/show_duplicates.py
# Vorn stehen die Quellen der Häuser selbst (sektor, azconni): nur sie
# verlinken auf den Laden statt auf einen Aggregator.
# cybersax steht hinten, weil die Quelle keine Event-Permalinks hat, sondern
# nur die Tagesseite - stünde sie vorn, verlinkte der Newsletter auf eine
# Tagesliste statt auf die Veranstaltung (siehe README).
SOURCE_PRIORITY=sektor,azconni,rauze,ra,kulturkalender,cybersax,reddit

# Auf false stellen, um jede Quelle unverändert durchzureichen: bereits
# ausgeblendete Einträge werden beim nächsten Lauf wieder sichtbar (Events
# stehen dann doppelt im Newsletter). Welche Quellen einen Eintrag geliefert
# haben, wird weiterhin mitgeschrieben.
DEDUP_ENABLED=true

# --- Reddit als zusätzliche Quelle (optional) -------------------------------
# Fängt Veranstaltungen ein, die in keinem Kalender stehen, sondern nur in
# Posts angekündigt werden. Läuft einmal täglich zusammen mit dem Tages-Push.
# Solange REDDIT_ENABLED=false ist, ändert sich am bisherigen Betrieb nichts.
REDDIT_ENABLED=false

# App vom Typ "script" anlegen unter https://www.reddit.com/prefs/apps
# (Client-ID steht klein unter dem App-Namen, Secret daneben)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=dd-was-geht/1.0 (by /u/dein-reddit-name)

# Welche Subreddits beobachtet werden, steht in config/reddit_subreddits.txt.
# Kandidaten finden: python3 tools/discover_subreddits.py Dresden
REDDIT_SUBREDDITS_FILE=./config/reddit_subreddits.txt

# API-Key von https://console.anthropic.com - wird gebraucht, um aus
# Fließtext-Posts Datum/Ort/Titel herauszulesen. ACHTUNG: eigene, nutzungs-
# basierte Abrechnung, NICHT im Claude-Pro-Abo enthalten (grob 1-3 $/Monat
# bei einem Lauf pro Tag).
ANTHROPIC_API_KEY=

# Wie sicher sich das Modell sein muss, damit ein Post als Event gilt (0-1)
REDDIT_LLM_CONFIDENCE_THRESHOLD=0.6

# Notbremse: mehr LLM-Aufrufe macht ein einzelner Lauf nicht
REDDIT_LLM_MAX_CALLS_PER_RUN=20
